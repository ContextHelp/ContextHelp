# hop.top/ben pin — read by the Makefile to decide which version of ben
# to install for the recall harness.
#
# Format: one shell-style assignment per line, no inline comments.
#
# Update protocol:
#   1. Bump BEN_VERSION here.
#   2. Run `make ben` locally and confirm the suites still pass.
#   3. Commit the bump in its own PR with Operator-Impact: none.
#
# Currently pinned to the dev-tip SHA because hop.top/ben has not cut a
# tagged release yet (per its README "Do Not Use — History Will Be
# Rewritten" warning). The kit-replace-style local override in go.work
# (replace hop.top/ben => /local/path) takes precedence on dev machines
# that already have the sibling worktree checked out.
BEN_VERSION=40b7b921cdc22e891c119b1fe40160b0b4395163
BEN_MODULE=hop.top/ben
BEN_BIN_PATH=hop.top/ben/cmd/ben
