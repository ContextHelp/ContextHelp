# Compose env file for the dev profile:
#
#   cp docker/.env.dev.example docker/.env.dev
#   docker compose --env-file docker/.env.dev --profile dev up
#
# Compose reads it for ${VAR} interpolation in docker-compose.yml only;
# no container sees a key unless docker-compose.yml passes it. dpkms
# settings are config keys: docker/config.docker.yaml (the image's),
# docker/dpkms-local.yaml (blob storage, providers); API tokens go in
# docker/dpkms-auth.yaml. Compose passes two groups from this file:
# provider API keys and the non-secret S3 settings.

# Bus hub token, required: openssl rand -hex 32
DPKMS_BUS_TOKEN=

# ── Provider API keys (optional) ─────────────────────────────────────────────
# Providers read API keys from env only; docker-compose.yml passes these
# four to dpkms. Provider backends, models and endpoints are config keys
# in docker/dpkms-local.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── S3 blob settings (optional) ──────────────────────────────────────────────
# Non-secret storage.blob.s3.* settings; docker-compose.yml passes these
# five to dpkms. A set one overrides docker/dpkms-local.yaml; left out,
# the file's value stays. storage.blob.backend and the S3 access and
# secret keys are set in docker/dpkms-local.yaml only: compose never
# passes the keys.
# CTXT_BLOB_S3_ENDPOINT=https://s3.example.com
# CTXT_BLOB_S3_REGION=us-east-1
# CTXT_BLOB_S3_BUCKET=ctxt-blobs
# CTXT_BLOB_S3_PREFIX=dpkms/
# CTXT_BLOB_S3_USE_PATH_STYLE=true
