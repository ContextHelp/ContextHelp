# Compose env file for the dev profile:
#
#   cp docker/.env.dev.example docker/.env.dev
#   docker compose --env-file docker/.env.dev --profile dev up
#
# Compose reads it for ${VAR} interpolation in docker-compose.yml only;
# no container sees a key unless docker-compose.yml passes it. dpkms
# settings are config keys: docker/config.docker.yaml (the image's),
# docker/dpkms-local.yaml (blob storage, providers); API tokens go in
# docker/dpkms-auth.yaml.

# Bus hub token, required: openssl rand -hex 32
DPKMS_BUS_TOKEN=

# ── Provider API keys (optional) ─────────────────────────────────────────────
# Providers read API keys from env only; docker-compose.yml passes these
# four to dpkms. Provider backends, models and endpoints are config keys
# in docker/dpkms-local.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
