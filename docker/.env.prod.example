# Compose env file for the prod profile:
#
#   cp docker/.env.prod.example docker/.env.prod
#   docker compose --env-file docker/.env.prod --profile prod up -d
#
# Compose reads it for ${VAR} interpolation in docker-compose.yml only;
# no container sees a key unless docker-compose.yml passes it. dpkms
# settings are config keys: docker/config.docker.yaml (the image's
# /app/config.yaml), docker/dpkms-local.yaml (blob storage, providers);
# API tokens go in docker/dpkms-auth.yaml.

# ── Required ─────────────────────────────────────────────────────────────────
# Domain for Caddy TLS (use real FQDN in production)
DOMAIN=ctxt.example.com

# ACME email for Let's Encrypt notifications
ACME_EMAIL=admin@example.com

# Bus hub token: openssl rand -hex 32
DPKMS_BUS_TOKEN=

# ── Provider API keys (optional) ─────────────────────────────────────────────
# Providers read API keys from env only; docker-compose.yml passes these
# four to dpkms. Provider backends, models and endpoints are config keys
# in docker/dpkms-local.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── Image ────────────────────────────────────────────────────────────────────
# Image tag to deploy
TAG=latest

# ── Build metadata (set by CI) ───────────────────────────────────────────────
# VERSION=1.2.3
# GIT_COMMIT=abc1234
# BUILD_TIME=2026-03-13T00:00:00Z
