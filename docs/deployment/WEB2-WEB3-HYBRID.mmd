graph TB
    subgraph "User Layer"
        CLI["CLI: ctxt add/find/make"]
        TUI["TUI: Interactive"]
        API["REST/gRPC API"]
    end

    subgraph "dPKMS + ctxt Core (Single Node)"
        Storage["Storage Abstraction Layer"]
        Pipeline["Pipeline Runtime"]
        Jobs["Job System + Outbox"]
        Query["Query Engine"]
        Registry["Registry Client"]
    end

    subgraph "Storage Drivers (Pluggable)"
        SQLite["SQLite (Local)"]
        Postgres["PostgreSQL (Cloud)"]
        IPFS["IPFS (P2P)"]
        Arweave["Arweave (Archive)"]
        Blockchain["Blockchain (Metadata)"]
    end

    subgraph "Network Transports (Pluggable)"
        HTTP["HTTP Transport<br/>(Web2)"]
        LibP2P["libp2p Transport<br/>(Web3 P2P)"]
        RPC["RPC Transport<br/>(Blockchain)"]
        RegistryProto["Registry Protocol<br/>(Federated)"]
    end

    subgraph "Web2 Cloud Infrastructure"
        CloudDB[("PostgreSQL Cluster<br/>(HA, Replicas)")]
        S3["S3/Cloud Storage<br/>(Attachments)"]
        CloudAuth["OAuth2/SCIM<br/>(Identity)"]
    end

    subgraph "Web3 IPFS Infrastructure"
        DHT["DHT<br/>(Peer Discovery)"]
        Cluster["IPFS Cluster<br/>(Pinning)"]
        Pinning["Pinning Service<br/>(nft.storage, estuary)"]
    end

    subgraph "Web3 Blockchain Infrastructure"
        Solana["Solana Mainnet<br/>(Settlement)"]
        Ethereum["Ethereum Mainnet<br/>(Settlement)"]
        SmartContract["Smart Contracts<br/>(Registry, ACL)"]
    end

    subgraph "Archival & Permanent Storage"
        ArweaveNetwork["Arweave Network<br/>(Permanent, Immutable)"]
        Bundler["Bundler Service<br/>(Cost Optimization)"]
    end

    %% Core connections
    CLI --> Storage
    TUI --> Storage
    API --> Storage

    Storage --> SQLite
    Storage --> Postgres
    Storage --> IPFS
    Storage --> Arweave
    Storage --> Blockchain

    Pipeline --> Query
    Pipeline --> Jobs
    Query --> Storage
    Registry --> Storage

    %% Network transports
    Storage --> HTTP
    Storage --> LibP2P
    Storage --> RPC
    Registry --> RegistryProto

    %% Web2 Cloud
    Postgres --> CloudDB
    HTTP --> CloudAuth
    HTTP --> S3

    %% Web3 IPFS
    IPFS --> Cluster
    Cluster --> DHT
    Cluster --> Pinning
    LibP2P --> DHT

    %% Web3 Blockchain
    Blockchain --> RPC
    RPC --> Solana
    RPC --> Ethereum
    SmartContract -.->|Registry Metadata| Solana
    SmartContract -.->|Registry Metadata| Ethereum

    %% Archival
    Arweave --> Bundler
    Bundler --> ArweaveNetwork

    %% Sync Jobs
    Jobs -.->|Async Outbox| CloudDB
    Jobs -.->|Async Outbox| Cluster
    Jobs -.->|Async Outbox| Bundler
    Jobs -.->|Async Outbox| Solana

