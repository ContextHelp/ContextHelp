# ContextHelp Development Environment Configuration
# Copy this file to .env and customize as needed

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ENV=development
DEV_MODE=true

# ==============================================================================
# STORAGE BACKEND
# ==============================================================================

# Default: SQLite (local-first, zero-config)
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/sqlite/contexthelp.db
SQLITE_WAL_MODE=true
SQLITE_BUSY_TIMEOUT=5000

# Alternative: PostgreSQL (multi-user, production)
# STORAGE_BACKEND=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=contexthelp
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=contexthelp
# POSTGRES_SSL_MODE=disable
# POSTGRES_MAX_CONNECTIONS=25
# POSTGRES_MAX_IDLE_CONNECTIONS=5

# ==============================================================================
# OPTIONAL SERVICES (Docker Compose)
# ==============================================================================

# Redis (distributed job queue, caching)
# REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Qdrant (vector search)
# QDRANT_ENABLED=false
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=contexthelp

# ==============================================================================
# AI PROVIDERS
# ==============================================================================

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.7

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-opus-20240229
# ANTHROPIC_MAX_TOKENS=4096

# Ollama (local models)
# OLLAMA_ENABLED=false
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama2

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout
LOG_FILE=./data/logs/contexthelp.log

# ==============================================================================
# API SERVER (dPKMS)
# ==============================================================================

# REST API
API_HOST=localhost
API_PORT=8080
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s

# gRPC API
GRPC_PORT=9090
GRPC_MAX_RECV_SIZE=16777216

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ==============================================================================
# JOBS & WORKERS
# ==============================================================================

WORKER_COUNT=4
WORKER_POLL_INTERVAL=1s
JOB_RETRY_LIMIT=3
JOB_TIMEOUT=5m
JOB_CLEANUP_INTERVAL=1h

# ==============================================================================
# SECURITY
# ==============================================================================

# Encryption (optional)
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY_DERIVATION=pbkdf2
# ENCRYPTION_PASSPHRASE=

# Authentication (optional)
AUTH_ENABLED=false
# JWT_SECRET=
# JWT_EXPIRATION=24h

# ==============================================================================
# PIPELINES (ctxt)
# ==============================================================================

PIPELINE_DEFAULT_TIMEOUT=5m
PIPELINE_CACHE_ENABLED=true
PIPELINE_MAX_CONCURRENT=4

# ==============================================================================
# PROFILES (ctxt)
# ==============================================================================

PROFILE_DEFAULT=general
PROFILE_DIRECTORY=./configs/profiles

# ==============================================================================
# REGISTRIES (dPKMS)
# ==============================================================================

REGISTRY_SYNC_INTERVAL=24h
REGISTRY_CACHE_TTL=7d
# REGISTRY_AUTH_TOKEN=

# ==============================================================================
# DEVELOPMENT
# ==============================================================================

# Profiling
ENABLE_PROFILING=false
PPROF_PORT=6060

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9091

# Debug
DEBUG_SQL=false
DEBUG_JOBS=false
DEBUG_PIPELINES=false

# ==============================================================================
# TESTING
# ==============================================================================

TEST_DB_PATH=./data/sqlite/contexthelp_test.db
TEST_CLEANUP=true
TEST_FIXTURES=./test/fixtures
