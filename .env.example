# ContextHelp development environment template
#
# Nothing loads this file automatically: neither ctxt/dpkms, the Makefile,
# the Taskfile, mise nor the compose files read .env. Export it into your
# shell yourself:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# Only variables something actually reads are listed; values shown are the
# built-in defaults unless noted. Everything else is set in the config file
# (see config/config.example.yaml). Full reference: docs/environment-variables/.

# ==============================================================================
# STORAGE
# ==============================================================================

# Backend: sqlite or postgres. Config key: storage.type
# CH_STORAGE_TYPE=sqlite
#
# The database location (SQLite file or Postgres DSN) is storage.path in the
# config file.

# ==============================================================================
# API SERVER (dpkms serve)
# ==============================================================================

# Listener ports. Config keys: server.port, server.grpc_port,
# server.cookie_bridge_port
# CH_SERVER_PORT=8080
# CH_GRPC_PORT=9090
# CH_COOKIE_BRIDGE_PORT=9377
#
# No bind-host variable: REST and gRPC bind 127.0.0.1 or 0.0.0.0 according
# to server.access in the config file. The cookie bridge always binds
# 127.0.0.1.

# ==============================================================================
# JOBS
# ==============================================================================

# How often idle workers poll for new jobs (min 50ms). Config key:
# jobs.poll_interval
# DPKMS_POLL_INTERVAL=500ms

# Default retry limit for fan-out jobs. Config key: jobs.max_retries
# DPKMS_MAX_RETRIES=3

# ==============================================================================
# PROFILES
# ==============================================================================

# Default focus profile (unset by default). Config key: profile.default
# CTXT_PROFILE=general

# ==============================================================================
# AI PROVIDERS
# ==============================================================================

# Checked after the secrets store (`dpkms secret set <KEY>`).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ==============================================================================
# POSTGRES INTEGRATION TESTS
# ==============================================================================

# Read only by `go test -tags=integration` to build a test DSN (POSTGRES_DSN,
# when set, wins). Values match docker-compose.dev.yml. dpkms itself never
# reads these; it takes its Postgres DSN from storage.path.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=ctxt
# POSTGRES_PASSWORD=ctxt
# POSTGRES_DB=ctxt
