{
  "title": "representation_node_metadata",
  "description": "Metadata of a graph node that holds media-derived text (ADR-076 section 1-2). A summary representation is a summary node; every other kind is a section node.",
  "type": "object",
  "required": ["representation"],
  "additionalProperties": true,
  "properties": {
    "representation": {
      "enum": ["caption", "ocr", "transcript", "frame_caption", "frame_ocr", "summary", "extracted_text"]
    },
    "start_ms": {"type": "integer", "minimum": 0},
    "end_ms": {"type": "integer", "minimum": 0},
    "speaker": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 0},
    "frame_index": {"type": "integer", "minimum": 0},
    "frame_ms": {"type": "integer", "minimum": 0},
    "image_index": {"type": "integer", "minimum": 0},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "origin": {"const": "sidecar"}
  },
  "allOf": [
    {
      "if": {"properties": {"representation": {"enum": ["frame_caption", "frame_ocr"]}}},
      "then": {"required": ["frame_index"]}
    }
  ]
}
