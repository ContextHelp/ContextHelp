{
  "title": "lateral_events",
  "type": "object",
  "description": "All bus events emitted within the lateral pipeline. Runtime topics are ctxt.lateral.<key>. Notation: [Source].[Category].[Object][optional [modifier]].[Action][optional sigil qualifier]. Sigils: ?reason, +mechanism, =property, @circumstance.",
  "definitions": {
    "scan.started":                          {"type": "object", "properties": {"object_id": {"type": "string"}}},
    "scan.completed":                        {"type": "object", "properties": {"object_id": {"type": "string"}, "candidates_emitted": {"type": "integer"}}},
    "scan.deferred":                         {"type": "object", "properties": {"object_id": {"type": "string"}, "reason": {"type": "string"}}},
    "scan.skipped":                          {"type": "object", "properties": {"object_id": {"type": "string"}, "reason": {"type": "string"}}},
    "scan[jit].proposal_failed":             {"type": "object", "properties": {"object_id": {"type": "string"}, "reason": {"type": "string"}}},
    "subpath.failed":                        {"type": "object", "properties": {"object_id": {"type": "string"}, "subpath": {"type": "string"}, "reason": {"type": "string"}}},
    "candidate.created":                     {"type": "object", "properties": {"candidate_id": {"type": "string"}}},
    "candidate.promoted":                    {"type": "object", "properties": {"candidate_id": {"type": "string"}, "path": {"type": "string"}}},
    "candidate.expired":                     {"type": "object", "properties": {"candidate_id": {"type": "string"}, "reason": {"type": "string"}}},
    "candidate.rejected":                    {"type": "object", "properties": {"candidate_id": {"type": "string"}}},
    "candidate.resurrected":                 {"type": "object", "properties": {"candidate_id": {"type": "string"}}},
    "reaper[cycle].started":                 {"type": "object"},
    "reaper[cycle].completed":               {"type": "object", "properties": {"expired": {"type": "integer"}, "duration_ms": {"type": "integer"}}},
    "reaper[cycle].failed":                  {"type": "object", "properties": {"reason": {"type": "string"}}},
    "reaper[cycle].skipped?overlap":         {"type": "object"},
    "sanity[check].violated":                {"type": "object", "properties": {"candidate_id": {"type": "string"}, "violation": {"type": "string"}}},
    "score.flagged=invalid":                 {"type": "object", "properties": {"candidate_id": {"type": "string"}}},
    "signal.degraded":                       {"type": "object", "properties": {"signal": {"type": "string"}, "reason": {"type": "string"}}},
    "resolution.flagged=ambiguous":          {"type": "object", "properties": {"candidate_id": {"type": "string"}}},
    "recipe.refreshed":                      {"type": "object", "properties": {"source_domain": {"type": "string"}, "page_type": {"type": "string"}}},
    "recipe.served@during_llm_outage":       {"type": "object", "properties": {"source_domain": {"type": "string"}, "page_type": {"type": "string"}}},
    "classification.matched+heuristic":      {"type": "object", "properties": {"source_domain": {"type": "string"}, "page_type": {"type": "string"}}},
    "classification.produced+llm":           {"type": "object", "properties": {"source_domain": {"type": "string"}, "page_type": {"type": "string"}, "duration_ms": {"type": "integer"}}},
    "classification.hit+recipe_cache":       {"type": "object", "properties": {"source_domain": {"type": "string"}, "page_type": {"type": "string"}}},
    "research[intent].boosted":              {"type": "object", "properties": {"context_shape": {"type": "string"}, "boost_factor": {"type": "number"}}},
    "research[intent].suppressed":           {"type": "object", "properties": {"context_shape": {"type": "string"}, "reason": {"type": "string"}}}
  }
}
