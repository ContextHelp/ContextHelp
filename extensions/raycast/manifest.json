{
  "name": "Raycast Extension",
  "slug": "raycast-extension",
  "description": "ContextHelp extension for Raycast, providing quick search and capture capabilities directly from the Raycast launcher.",
  "category": "extensions",
  "author": {
    "name": "Jadb",
    "github": "jadb"
  },
  "version": "1.0.0",
  "requires": {
    "ctxt": true,
    "dpkms": true,
    "tools": ["Raycast", "Node.js 18+"]
